SKIM_STAGE=stage2_warmup
OUTPUT_DIR=./outputs
RUN_NAME=skim-stage2
LOG_WANDB=false

COMPRESSOR_MODEL=Qwen/Qwen3-8B
LLM_MODEL=Qwen/Qwen3-8B
K_VALUES=256,512
K_STRATEGY=multi_k_per_case

SKILL_QA_TRAIN_DATA_CONFIG=[{"path":"./prepare/output/wikihow_processed.jsonl","name":"wikihow","size":0,"enabled":true}]
SKILL_QA_VAL_DATA_CONFIG=[{"path":"./prepare/output/wikihow_processed.jsonl","name":"wikihow_val","size":1000,"enabled":true}]
SKILL_QA_TRAIN_LLM=false
SKILL_QA_LOSS=sft

EPOCHS=1
BATCH_SIZE=1
GRAD_ACC=8
MAX_LENGTH=4096
LR=1e-5
USE_DEEPSPEED=false
DEEPSPEED_CONFIG=./code/config/deepspeed_zero2.json
