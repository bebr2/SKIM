SKIM_STAGE=stage1_reconstruction
OUTPUT_DIR=./outputs
RUN_NAME=skim-stage1
LOG_WANDB=false

COMPRESSOR_MODEL=Qwen/Qwen3-8B
LLM_MODEL=Qwen/Qwen3-8B
K_VALUES=256,512
K_STRATEGY=multi_k_per_case

STAGE1_TRAIN_PATH=./code/data/stage1_train.sample.jsonl
STAGE1_VAL_PATH=./code/data/stage1_val.sample.jsonl
STAGE1_CHECKPOINT=

EPOCHS=1
BATCH_SIZE=1
GRAD_ACC=8
MAX_LENGTH=4096
LR=1e-5
USE_DEEPSPEED=false
DEEPSPEED_CONFIG=./code/config/deepspeed_zero2.json
