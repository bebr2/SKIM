SKIM_STAGE=stage3_alignment
OUTPUT_DIR=./outputs
RUN_NAME=skim-stage3
LOG_WANDB=false

COMPRESSOR_MODEL=Qwen/Qwen3-8B
LLM_MODEL=Qwen/Qwen3-8B
K_VALUES=256,512
K_STRATEGY=multi_k_per_case

SKILL_QA_TRAIN_DATA_CONFIG=[{"path":"./prepare/output/stage3_train.jsonl","name":"skill_tasks","size":0,"enabled":true}]
SKILL_QA_VAL_DATA_CONFIG=[{"path":"./prepare/output/stage3_val.jsonl","name":"skill_tasks_val","size":1000,"enabled":true}]
SKILL_QA_TRAIN_LLM=lora
SKILL_QA_LOSS=sft
SKILL_QA_LORA_R=16
SKILL_QA_LORA_ALPHA=32
SKILL_QA_LORA_DROPOUT=0.05
SKILL_QA_LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

EPOCHS=1
BATCH_SIZE=1
GRAD_ACC=8
MAX_LENGTH=4096
LR=1e-5
USE_DEEPSPEED=false
DEEPSPEED_CONFIG=./code/config/deepspeed_zero2.json
